{
  "name": "zhurzh-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "axios": "^1.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "postbuild": "cp CNAME dist/ && cp dist/index.html dist/404.html",
    "dev": "vite --host --no-open",
    "build": "vite build",
    "serve": "vite preview",
    "api-generate": "swagger-typescript-api -p https://api.zhurzh.art/v3/api-docs -o ./src/shared/api -n api.gen.ts --axios --union-enums",
    "dev-api-generate": "swagger-typescript-api -p http://localhost:8092/v3/api-docs -o ./src/shared/api -n api.gen.ts --axios --union-enums"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.3.0",
    "swagger-typescript-api": "^13.0.21",
    "vite": "^5.3.3"
  }
}
